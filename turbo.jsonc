{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.node.json", "tsconfig.browser.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**", "playground/.nuxt/**", ".apikit-i18n/**"],
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [],
    },
  },
}
