# Write exact versions (e.g. 1.2.3) to package.json when adding dependencies (no ^ / ~ ranges).
save-exact=true

# Control hoisting behavior (whether packages are lifted higher in node_modules).
# Higher hoisting can improve compatibility with tools that expect a flat node_modules,
# but it can also hide missing direct dependencies by making transitive deps appear importable.
shamefully-hoist=true

# Automatically install missing peerDependencies when possible to reduce peer-related install friction.
auto-install-peers=true

# Enforce peerDependencies strictly: treat missing or incompatible peers as install errors (fail fast).
strict-peer-dependencies=true
