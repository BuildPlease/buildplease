# Write exact versions (e.g. 1.2.3) to package.json when adding dependencies (no ^ / ~ ranges).
save-exact=true
#Controls whether dependencies are hoisted higher in node_modules.
shamefully-hoist=true
# Automatically install missing peerDependencies when possible to reduce peer-related install friction.
auto-install-peers=true
# Enforce peerDependencies strictly: treat missing or incompatible peers as install errors (fail fast).
strict-peer-dependencies=true
