#!/usr/bin/env bash
set -euo pipefail

bold() { printf "\033[1m%s\033[0m" "$*"; }

require() { command -v "$1" >/dev/null || { echo "Missing required tool: $1"; exit 1; }; }
require lerna
require pnpm
require node

# npm-check-updates via pnpm dlx; mute npm noise
ncu() {
  NPM_CONFIG_USERCONFIG=/dev/null \
  NPM_CONFIG_LOGLEVEL=error \
  pnpm dlx npm-check-updates@latest "$@"
}

# Prompt from a TTY even when STDIN is not a TTY (e.g. pnpm scripts)
prompt_yn() {
  local msg="$1" reply=""
  if [ -t 0 ]; then
    read -r -p "$msg" reply
  else
    # shellcheck disable=SC2162
    read -r -p "$msg" reply < /dev/tty || reply=""
  fi
  [[ $reply =~ ^[Yy]$ ]]
}

while IFS= read -r WS; do
  [ -f "$WS/package.json" ] || continue
  pkg_name=$(node -e 'try{process.stdout.write(require(process.argv[1]).name||"")}catch{process.stdout.write("")}' "$WS/package.json")
  pkg_name=${pkg_name:-$WS}

  echo
  echo "— $(bold "$pkg_name") —"
  echo

  (
    cd "$WS"

    echo "▶ Outdated (dependencies):"
    pnpm outdated --prod || true
    echo

    echo "▶ Outdated (devDependencies):"
    pnpm outdated --dev || true
    echo

    echo "▶ Potential updates (peerDependencies):"
    ncu --dep peer || true
    echo

    if prompt_yn "Update $pkg_name to latest (prod/dev/optional/peer)? [y/N] "; then
      echo "→ Updating version ranges in package.json (ncu)…"
      ncu -u --target latest --dep prod,dev,optional,peer || true

      echo "→ Installing latest (pnpm up -L)…"
      pnpm up -L

      echo "→ Finalize lock & dedupe…"
      pnpm install
      pnpm dedupe || true

      echo "→ Post-check (remaining outdated):"
      pnpm outdated || true

      echo "✔ Updated $pkg_name"
    else
      echo "→ Skipping $pkg_name"
    fi
  )

done < <(lerna ls --all --parseable)

echo
echo "🎉 Done. All workspaces processed."
