#!/usr/bin/env bash
set -euo pipefail

# Run `pnpm outdated` in each workspace, streaming output (prefixed by [pkg-name]),
# but silencing all Lerna banners and avoiding printf errors.

lerna exec \
  --no-bail \
  --concurrency 1 \
  --loglevel silent \
  -- sh -c "\
    echo ''; \
    pkg_name=\$(grep -m1 '\"name\"' package.json | sed -E 's/.*\"name\": *\"([^\"]+)\".*/\1/'); \
    echo \"— \$pkg_name —\"; \
    pnpm outdated || true\
  "
