{
  "name": "@nidavellirx/meowv-nuxtkit",
  "version": "1.0.0",
  "description": "A Nuxt Kit for MVVM design pattern and Clean Code architecture, with foundation for web app",
  "repository": "git@github.com/Nidavellirx/meowv.git",
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "imports": {
    "#nuxtkit/*": "./dist/runtime/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run dev:prepare && npm run prepack",
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nidavellirx/meowv-webkit": "workspace:^",
    "@nuxt/kit": "4.1.1",
    "@iconify-json/flag": "^1.2.9",
    "defu": "6.1.4",
    "reflect-metadata": "0.2.2"
  },
  "peerDependencies": {
    "@nuxt/ui": "^3.3.3",
    "@nuxtjs/i18n": "^10.0.6",
    "inversify": "^7.9.1",
    "vue-i18n": "^11.1.11",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nuxt/devtools": "2.6.3",
    "@nuxt/module-builder": "1.0.2",
    "@nuxt/schema": "4.1.1",
    "@nuxt/ui": "3.3.3",
    "@nuxtjs/i18n": "10.0.6",
    "@types/node": "latest",
    "inversify": "7.9.1",
    "nuxt": "4.1.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "vue-i18n": "11.1.12",
    "vue-tsc": "3.0.6"
  }
}