{
  "name": "@meawkit/nuxtkit",
  "version": "1.0.0",
  "description": "A Nuxt Kit for MVVM design pattern and Clean Code architecture, with foundation for web app",
  "repository": "git@github.com/MeawKit/MeawKit.git",
  "license": "UNLICENSED",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "imports": {
    "#internal-runtime": "./dist/internal-runtime/index.mjs",
    "#internal-shared": "./dist/internal-shared/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./public": {
      "types": "./dist/public/index.d.mts",
      "import": "./dist/public/index.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run dev:prepare && pnpm run prepack",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "prepack": "nuxt-module-build build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/flag": "1.2.11",
    "@meawkit/webkit": "workspace:^",
    "@nuxt/kit": "4.4.2",
    "consola": "3.4.2",
    "defu": "6.1.6"
  },
  "devDependencies": {
    "@meawkit/identity": "workspace:^",
    "@nuxt/devtools": "3.2.4",
    "@nuxt/module-builder": "1.0.2",
    "@nuxt/schema": "4.4.2",
    "nuxt": "4.4.2",
    "unbuild": "3.6.1",
    "vitest": "4.1.2",
    "vue-tsc": "3.2.6"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.6.1",
    "@nuxtjs/i18n": "^10.2.4",
    "inversify": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "vue-i18n": "^11.3.1",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "unbuild": {
    "failOnWarn": false
  }
}
