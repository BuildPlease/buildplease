{
  "name": "@buildplease/nuxtkit",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/nuxtkit"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "imports": {
    "#internal-runtime": "./dist/internal-runtime/index.mjs",
    "#internal-shared": "./dist/internal-shared/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./public": {
      "types": "./dist/public/index.d.mts",
      "import": "./dist/public/index.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run dev:prepare && pnpm run prepack",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "prepack": "nuxt-module-build build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "vue-tsc --noEmit && nuxt typecheck playground"
  },
  "dependencies": {
    "@buildplease/core": "workspace:*",
    "@buildplease/webkit": "workspace:*",
    "@nuxt/kit": "4.5.2",
    "defu": "6.1.7"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:*",
    "@nuxt/devtools": "3.4.2",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.5.2",
    "nuxt": "catalog:",
    "unbuild": "3.6.1",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@nuxt/ui": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "vue-i18n": "11.4.9",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "unbuild": {
    "failOnWarn": true
  }
}
