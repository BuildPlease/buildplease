{
  "name": "@nidavellirx/meowv-nuxtkit",
  "version": "1.0.0",
  "description": "A Nuxt Kit for MVVM design pattern and Clean Code architecture, with foundation for web app",
  "type": "module",
  "author": "Simon Rastislav Kovačič",
  "license": "UNLICENSED",
  "repository": "git@github.com/Nidavellirx/meowv.git",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "imports": {
    "#nuxtkit/*": "./dist/runtime/*.js",
    "#shared/*": "./dist/shared/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run dev:prepare && npm run prepack",
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nidavellirx/meowv-webkit": "workspace:^",
    "@nuxt/kit": "4.2.2",
    "@iconify-json/flag": "1.2.10",
    "defu": "6.1.4"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.2.1",
    "@nuxtjs/i18n": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "inversify": "^7.10.6",
    "vue-i18n": "^11.2.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "3.1.1",
    "@nuxt/module-builder": "1.0.2",
    "@nuxt/schema": "4.2.2",
    "nuxt": "4.2.2",
    "vitest": "4.0.15",
    "vue-tsc": "3.1.8"
  }
}
