{
  "name": "@meawkit/devkit",
  "version": "1.0.0",
  "description": "Shared MeawKit repository hygiene toolkit.",
  "keywords": [],
  "license": "UNLICENSED",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.mts",
        "default": "./dist/src/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    }
  },
  "bin": {
    "devkit": "./bin/devkit.mjs"
  },
  "files": [
    "bin",
    "configs",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:src",
    "build:cli": "tsdown --config tsdown.config.cli.ts --config-loader unrun",
    "build:src": "tsdown --config tsdown.config.src.ts --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@meawkit/core": "workspace:^",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "citty": "0.2.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "3.3.0",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-yml": "3.6.0",
    "execa": "10.0.0",
    "globals": "17.8.0",
    "jiti": "2.7.0",
    "npm-check-updates": "23.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-ejs": "1.0.3",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "vue-eslint-parser": "10.4.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
