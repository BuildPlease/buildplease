{
  "name": "@buildplease/devkit",
  "version": "1.3.7",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/devkit"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.mts",
        "default": "./dist/src/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    }
  },
  "bin": {
    "devkit": "./bin/devkit.mjs"
  },
  "files": [
    "bin",
    "configs",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:src",
    "build:cli": "tsdown --config tsdown.config.cli.ts --config-loader unrun",
    "build:src": "tsdown --config tsdown.config.src.ts --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@buildplease/core": "workspace:*",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "citty": "0.2.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-vue": "10.12.1",
    "eslint-plugin-yml": "3.10.0",
    "execa": "10.2.1",
    "globals": "17.14.0",
    "jiti": "catalog:",
    "npm-check-updates": "23.1.1",
    "prettier": "3.10.1",
    "prettier-plugin-ejs": "1.0.3",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "vue-eslint-parser": "10.4.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
