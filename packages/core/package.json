{
  "name": "@buildplease/core",
  "version": "1.1.0",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/src-node/index.d.mts",
        "default": "./dist/src-node/index.mjs"
      },
      "require": {
        "types": "./dist/src-node/index.d.cts",
        "default": "./dist/src-node/index.cjs"
      }
    },
    "./node/test": {
      "import": {
        "types": "./dist/src-node-test/index.d.mts",
        "default": "./dist/src-node-test/index.mjs"
      },
      "require": {
        "types": "./dist/src-node-test/index.d.cts",
        "default": "./dist/src-node-test/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "async-mutex": "0.5.0",
    "bcryptjs": "3.0.3",
    "consola": "catalog:",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "jiti": "catalog:",
    "ms": "2.1.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:*",
    "@types/ms": "2.1.0"
  },
  "peerDependencies": {
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
