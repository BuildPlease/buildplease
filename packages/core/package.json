{
  "name": "@buildplease/core",
  "version": "1.3.0",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src-neutral/index.d.ts",
        "default": "./dist/src-neutral/index.js"
      },
      "require": {
        "types": "./dist/src-neutral/index.d.cts",
        "default": "./dist/src-neutral/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/src-application/browser.d.ts",
        "default": "./dist/src-application/browser.js"
      },
      "require": {
        "types": "./dist/src-application/browser.d.cts",
        "default": "./dist/src-application/browser.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/src-application/node.d.mts",
        "default": "./dist/src-application/node.mjs"
      },
      "require": {
        "types": "./dist/src-application/node.d.cts",
        "default": "./dist/src-application/node.cjs"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/src-testing/index.d.mts",
        "default": "./dist/src-testing/index.mjs"
      },
      "require": {
        "types": "./dist/src-testing/index.d.cts",
        "default": "./dist/src-testing/index.cjs"
      }
    }
  },
  "bin": {
    "buildplease": "./bin/buildplease.mjs"
  },
  "files": [
    "bin",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "async-mutex": "0.5.0",
    "bcryptjs": "3.0.3",
    "code-block-writer": "13.0.3",
    "consola": "3.4.2",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "jiti": "catalog:",
    "ms": "2.1.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:*",
    "@types/ms": "2.1.0"
  },
  "peerDependencies": {
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
