{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    /* Project output */
    "rootDir": "./",
    "outDir": "./dist",
    "declarationDir": "./dist/types",

    /* Project paths */
    "paths": {
      "@/*": ["./src/*"],
      "@internal/*": ["./src-internal/*"],
      "@node": ["./src-node/index.ts"],
      "@node/*": ["./src-node/*"],
      "@node-test": ["./src-node-test/index.ts"],
      "@node-test/*": ["./src-node-test/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["src", "src-node", "src-node-test", "src-internal", "test", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist"]
}
