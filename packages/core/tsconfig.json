{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Project output */
    "rootDir": "./",
    "outDir": "./dist",
    "declarationDir": "./dist/types",

    /* Neutral source ownership */
    "paths": {
      "@neutral/*": ["./src-neutral/*"],
      "@internal/neutral/*": ["./src-internal/neutral/*"],
      "#l10n": ["./src-neutral/l10n/index.ts"],
      "#resources": ["./resources/index.ts"]
    }
  },
  "include": ["src-neutral", "src-internal/neutral"],
  "exclude": ["node_modules", "dist"]
}
