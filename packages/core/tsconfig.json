{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Project output */
    "rootDir": "./",
    "outDir": "./dist",
    "declarationDir": "./dist/types",

    /* Runtime types */
    "types": ["node"],

    /* Project paths */
    "paths": {
      "@/*": ["./src/*"],
      "@internal/*": ["./src-internal/*"],
      "@node": ["./src-node/index.ts"],
      "@node/*": ["./src-node/*"]
    }
  },
  "include": ["src", "src-node", "src-internal", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
