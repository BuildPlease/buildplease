{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    /* Project output */
    "rootDir": "./",
    "outDir": "./dist",
    "declarationDir": "./dist/types",

    /* Project paths */
    "paths": {
      "@/*": ["./src/*"],
      "@src-cli/*": ["./src-cli/*"],
      "@src-internal/*": ["./src-internal/*"],
      "@src-node/*": ["./src-node/*"],
      "@src-test/*": ["./src-test/*"],
      "#l10n": ["./src/l10n/index.ts"],
      "#resources": ["./resources/index.ts"],

      "#test/*": ["./test/*"]
    }
  },
  "include": ["src", "src-cli", "src-node", "src-test", "src-internal", "test", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist"]
}
