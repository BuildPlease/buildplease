{
  "name": "@buildplease/webkit",
  "version": "1.3.1",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/webkit"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src-neutral/index.d.ts",
        "default": "./dist/src-neutral/index.js"
      },
      "require": {
        "types": "./dist/src-neutral/index.d.cts",
        "default": "./dist/src-neutral/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/src-application/browser.d.ts",
        "default": "./dist/src-application/browser.js"
      },
      "require": {
        "types": "./dist/src-application/browser.d.cts",
        "default": "./dist/src-application/browser.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/src-application/node.d.mts",
        "default": "./dist/src-application/node.mjs"
      },
      "require": {
        "types": "./dist/src-application/node.d.cts",
        "default": "./dist/src-application/node.cjs"
      }
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@buildplease/core": "workspace:*"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:*"
  },
  "peerDependencies": {
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
