{
  "name": "@buildplease/webkit",
  "version": "1.0.0",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/webkit"
  },
  "license": "UNLICENSED",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/src-node/index.d.mts",
        "default": "./dist/src-node/index.mjs"
      },
      "require": {
        "types": "./dist/src-node/index.d.cts",
        "default": "./dist/src-node/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@buildplease/core": "workspace:^",
    "axios": "1.19.0"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:^"
  },
  "peerDependencies": {
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
