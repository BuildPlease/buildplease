{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Project output */
    "rootDir": "./",
    "outDir": "./dist",
    "declarationDir": "./dist/types",

    /* Project paths */
    "types": ["node"],
    "paths": {
      "@neutral/*": ["./src-neutral/*"],
      "@browser/*": ["./src-browser/*"],
      "@node/*": ["./src-node/*"],
      "@internal/neutral/*": ["./src-internal/neutral/*"],
      "#l10n": ["./src-neutral/l10n/index.ts"],
      "#resources": ["./resources/index.ts"],
      "#test/*": ["./test/*"]
    }
  },
  "include": [
    "resources",
    "src-neutral",
    "src-node",
    "src-browser",
    "src-internal",
    "src-application",
    "test",
    "tsdown.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
