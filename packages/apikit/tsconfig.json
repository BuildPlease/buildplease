{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    /* Project output */
    "rootDir": "./",
    "outDir": "./dist",
    "declarationDir": "./dist/types",

    /* Project paths */
    "paths": {
      "@/*": ["./src/*"],
      "@cli/*": ["./src-cli/*"],
      "@internal/*": ["./src-internal/*"],
      "@i18n/*": ["./.apikit-i18n/*"],
      "@node-test/*": ["./src-node-test/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src",
    "src-cli",
    "src-internal",
    "src-node-test",
    ".apikit-i18n",
    "types",
    "test",
    "tsdown.config.cli.ts",
    "tsdown.config.src.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
