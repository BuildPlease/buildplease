{
  "name": "@meawkit/apikit",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "UNLICENSED",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.mts",
        "default": "./dist/src/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/src/i18n/index.d.mts",
        "default": "./dist/src/i18n/index.mjs"
      },
      "require": {
        "types": "./dist/src/i18n/index.d.cts",
        "default": "./dist/src/i18n/index.cjs"
      }
    },
    "./node/test": {
      "import": {
        "types": "./dist/src-node-test/index.d.mts",
        "default": "./dist/src-node-test/index.mjs"
      },
      "require": {
        "types": "./dist/src-node-test/index.d.cts",
        "default": "./dist/src-node-test/index.cjs"
      }
    }
  },
  "bin": {
    "apikit": "./bin/apikit.mjs"
  },
  "files": [
    "bin",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "pnpm run build:i18n && pnpm run build:cli && pnpm run build:src",
    "build:cli": "tsdown --config tsdown.config.cli.ts --config-loader unrun",
    "build:i18n": "unrun src-cli/bin.ts build:i18n",
    "build:src": "tsdown --config tsdown.config.src.ts --config-loader unrun",
    "test": "pnpm run build:i18n && vitest run",
    "typecheck": "pnpm run build:i18n && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.3",
    "@fastify/under-pressure": "9.1.0",
    "@fastify/view": "12.0.0",
    "@meawkit/core": "workspace:^",
    "argon2": "0.45.1",
    "citty": "catalog:",
    "ejs": "6.0.1",
    "fastify-ip": "2.0.0",
    "fastify-metrics": "13.2.1",
    "fastify-plugin": "6.0.0",
    "i18next": "26.3.6",
    "jiti": "catalog:",
    "libphonenumber-js": "1.13.10",
    "lodash.merge": "4.6.2",
    "mime-types": "3.0.2",
    "nodemailer": "9.0.5",
    "uuid": "14.0.1",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@meawkit/identity": "workspace:^",
    "@types/ejs": "3.1.5",
    "@types/lodash.merge": "4.6.9",
    "@types/mime-types": "3.0.1",
    "@types/nodemailer": "8.0.1",
    "@types/validator": "13.15.10",
    "code-block-writer": "13.0.3"
  },
  "peerDependencies": {
    "fastify": "5.11.3",
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "sharp": "0.35.3",
    "zod": "catalog:"
  }
}
