{
  "name": "@buildplease/apikit",
  "version": "1.3.1",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/apikit"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.mts",
        "default": "./dist/src/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    },
    "./test": {
      "import": {
        "types": "./dist/src-testing/index.d.mts",
        "default": "./dist/src-testing/index.mjs"
      },
      "require": {
        "types": "./dist/src-testing/index.d.cts",
        "default": "./dist/src-testing/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@buildplease/core": "workspace:*",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fastify/under-pressure": "9.1.0",
    "@fastify/view": "12.0.0",
    "argon2": "0.45.1",
    "ejs": "6.0.1",
    "fastify-ip": "2.0.0",
    "fastify-metrics": "14.1.0",
    "fastify-plugin": "6.0.0",
    "i18next": "26.4.2",
    "libphonenumber-js": "1.13.12",
    "lodash.merge": "4.6.2",
    "mime-types": "3.0.2",
    "nodemailer": "10.0.0",
    "uuid": "catalog:",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:*",
    "@types/ejs": "3.1.5",
    "@types/lodash.merge": "4.6.9",
    "@types/mime-types": "3.0.1",
    "@types/validator": "13.15.10"
  },
