{
  "name": "@buildplease/apikit",
  "version": "1.0.2",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildPlease/buildplease.git",
    "directory": "packages/apikit"
  },
  "license": "MIT",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.mts",
        "default": "./dist/src/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    },
    "./node/test": {
      "import": {
        "types": "./dist/src-node-test/index.d.mts",
        "default": "./dist/src-node-test/index.mjs"
      },
      "require": {
        "types": "./dist/src-node-test/index.d.cts",
        "default": "./dist/src-node-test/index.cjs"
      }
    }
  },
  "bin": {
    "apikit": "./bin/apikit.mjs"
  },
  "files": [
    "bin",
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:src",
    "build:cli": "tsdown --config tsdown.config.cli.ts --config-loader unrun",
    "build:src": "tsdown --config tsdown.config.src.ts --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@buildplease/core": "workspace:*",
    "@dotenvx/dotenvx": "2.21.0",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fastify/under-pressure": "9.1.0",
    "@fastify/view": "12.0.0",
    "argon2": "0.45.1",
    "citty": "catalog:",
    "ejs": "6.0.1",
    "fastify-ip": "2.0.0",
    "fastify-metrics": "13.2.1",
    "fastify-plugin": "6.0.0",
    "i18next": "26.4.0",
    "jiti": "catalog:",
    "libphonenumber-js": "1.13.11",
    "lodash.merge": "4.6.2",
    "mime-types": "3.0.2",
    "nodemailer": "9.0.5",
    "uuid": "14.0.2",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "@buildplease/identity": "workspace:*",
    "@types/ejs": "3.1.5",
    "@types/lodash.merge": "4.6.9",
    "@types/mime-types": "3.0.1",
    "@types/nodemailer": "8.0.1",
    "@types/validator": "13.15.10",
    "code-block-writer": "13.0.3"
  },
  "peerDependencies": {
    "fastify": "5.12.1",
    "inversify": "catalog:",
    "reflect-metadata": "catalog:",
    "sharp": "0.35.3",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
