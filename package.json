{
  "name": "meawkit",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "repository": "git@github.com:MeawKit/MeawKit.git",
  "license": "UNLICENSED",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && lerna run build",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "sh -c './scripts/cleanup.sh \"$@\"' --",
    "dep:check": "ncu -ws --dep prod,dev,optional,peer",
    "dep:update": "ncu -ws -i --dep prod,dev,optional,peer --peer",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "lerna run typecheck"
  },
  "devDependencies": {
    "@swc/core": "1.15.32",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-vue": "10.9.0",
    "eslint-plugin-yml": "3.3.2",
    "globals": "17.5.0",
    "lerna": "9.0.7",
    "npm-check-updates": "22.0.1",
    "prettier": "3.8.3",
    "prettier-plugin-ejs": "1.0.3",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.4.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@swc/core": "1.15.32",
      "tsup": "8.5.1",
      "typescript": "5.9.3"
    }
  }
}
