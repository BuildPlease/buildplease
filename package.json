{
  "name": "meowv",
  "private": true,
  "type": "module",
  "repository": "git@github.com:Nidavellirx/meowv.git",
  "author": "Simon Rastislav Kovačič",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "update:check": "./scripts/update_check",
    "update:all": "./scripts/update_all",
    "clean": "rimraf \"**/{dist,.nuxt,.output,.runtime,.build,.apikit}\" --glob",
    "clean:deep": "./scripts/cleanup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm run clean && lerna run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.42.0",
    "@typescript-eslint/parser": "8.42.0",
    "typescript": "5.9.2",
    "eslint": "9.34.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.3.0",
    "lerna": "8.2.3",
    "rimraf": "6.0.1"
  },
  "packageManager": "pnpm@10.15.0"
}