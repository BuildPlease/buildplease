{
  "name": "meawkit",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "keywords": [],
  "author": "Simon Rastislav Kovačič",
  "license": "UNLICENSED",
  "repository": "git@github.com:MeawKit/MeawKit.git",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dep:check": "ncu -ws --dep prod,dev,optional,peer",
    "dep:update": "ncu -ws -i --dep prod,dev,optional,peer --peer",
    "clean": "node scripts/clean.mjs",
    "clean:deep": "sh -c './scripts/cleanup.sh \"$@\"' --",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "build": "pnpm run clean && lerna run build",
    "typecheck": "lerna run typecheck"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "3.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-vue": "10.8.0",
    "eslint-plugin-yml": "3.3.1",
    "globals": "17.4.0",
    "jsonc-eslint-parser": "3.1.0",
    "npm-check-updates": "20.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-ejs": "1.0.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "vue-eslint-parser": "10.4.0",
    "yaml-eslint-parser": "2.0.0",
    "lerna": "9.0.7",
    "@swc/core": "1.15.24",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "tsup": "8.5.1",
      "@swc/core": "1.15.24"
    }
  }
}
