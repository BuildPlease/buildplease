{
  "name": "buildplease",
  "version": "1.0.0",
  "private": true,
  "description": "A TypeScript ecosystem project for modern applications.",
  "keywords": [],
  "license": "UNLICENSED",
  "author": "Simon Rastislav Kovačič",
  "type": "module",
  "scripts": {
    "build": "turbo run build --log-order=grouped",
    "clean": "devkit run clean",
    "clean:deep": "devkit run clean-deep",
    "dep:check": "devkit run dep-check",
    "dep:update": "devkit run dep-update",
    "format": "devkit run format-fix && devkit run lint-fix",
    "preinstall": "npx only-allow pnpm",
    "test": "turbo run test --log-order=grouped",
    "typecheck": "turbo run typecheck --log-order=grouped"
  },
  "devDependencies": {
    "@buildplease/devkit": "workspace:*",
    "@types/node": "26.4.1",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
