{
  "name": "meowv",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "keywords": [],
  "author": "Simon Rastislav Kovačič",
  "license": "UNLICENSED",
  "repository": "git@github.com:Nidavellirx/meowv.git",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dep:check": "ncu -ws --dep prod,dev,optional,peer",
    "dep:update": "ncu -ws -i --dep prod,dev,optional,peer --peer",
    "clean": "rimraf \"**/{dist,.nuxt,.output,.runtime,.build,.apikit}\" --glob",
    "clean:deep": "./scripts/cleanup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "build": "pnpm run clean && lerna run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "2.20.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-unicorn": "61.0.2",
    "eslint-plugin-vue": "10.4.0",
    "eslint-plugin-yml": "1.18.0",
    "globals": "16.4.0",
    "jsonc-eslint-parser": "2.4.0",
    "npm-check-updates": "^18.1.1",
    "prettier": "3.6.2",
    "prettier-plugin-ejs": "1.0.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "6.0.1",
    "vue-eslint-parser": "10.2.0",
    "yaml-eslint-parser": "1.3.0",
    "lerna": "8.2.4"
  },
  "packageManager": "pnpm@10.16.1"
}
