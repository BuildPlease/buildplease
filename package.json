{
   "name": "meowv",
   "private": true,
   "type": "module",
   "repository": "git@github.com:Nidavellirx/meowv.git",
   "author": "Simon Rastislav Kovačič",
   "workspaces": [
      "packages/*"
   ],
   "scripts": {
      "preinstall": "npx only-allow pnpm",
      "update:check": "./scripts/update_check",
      "update:all": "./scripts/update_all",
      "clean": "rimraf \"**/{dist,.nuxt,.output,.runtime,.build,.apikit}\" --glob",
      "clean:deep": "pnpm run clean && ./scripts/cleanup",
      "lint": "eslint .",
      "lint:fix": "eslint . --fix",
      "build": "pnpm run clean && lerna run build"
   },
   "devDependencies": {
      "@typescript-eslint/eslint-plugin": "8.33.1",
      "@typescript-eslint/parser": "8.33.1",
      "eslint": "9.28.0",
      "eslint-plugin-import": "2.31.0",
      "eslint-plugin-prettier": "5.4.1",
      "globals": "16.2.0",
      "lerna": "8.2.2",
      "rimraf": "6.0.1"
   },
   "packageManager": "pnpm@10.11.1"
}
